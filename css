/* ============================================================
   TOKENS GLOBAIS
============================================================ */
:root {
    --gold:        #D6B377;
    --gold-soft:   #cdb68c;
    --gold-pale:   #f0d8b0;
    --gold-light:  #d4b87a;
    --gold-dark:   #a88a3e;
    --orange:      #ff8c00;
    --purple:      #b14fff;
    --black:       #050505;
    --black-light: #141414;
    --black-medium:#1a1a1a;
    --black-1:     #0d0d0d;
    --black-2:     #141414;
    --black-3:     #1a1a1a;
    --dark-bg:     #121212;
    --card-bg:     #1e1e1e;
    --text-color:  #ffffff;

    --font-display: 'Cinzel', 'Times New Roman', serif;
    --font-body:    'Cormorant Garamond', Georgia, serif;

    --transition: 0.35s cubic-bezier(.4,0,.2,1);
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 18px;
}

/* ============================================================
   RESET BASE
============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { background: #0a0a0a; color: #fff; overflow-x: hidden; font-family: var(--font-body); }
img { max-width: 100%; height: auto; display: block; border-radius: 10px; }
button { cursor: pointer; border: none; font-family: inherit; }



        /* --- ESTILOS DO MENU (DEVE FICAR DENTRO DE <style>) --- */
        #menu-toggle {
            display: none; /* Esconde o checkbox real */
        }

        /* Ícone do Menu (Hambúrguer) */
        .menu-icon {
            display: inline-block;
            padding: 15px;
            cursor: pointer;
            font-size: 24px;
            background: #333;
            color: white;
            position: fixed;
            top: 10px;
            left: 10px;
            z-index: 1000; /* Aumentado para ficar acima de tudo */
            border-radius: 4px;
        }

        /* Menu Lateral */
        .side-menu {
            position: fixed;
            top: 0;
            left: -250px; /* Escondido à esquerda */
            width: 250px;
            height: 100%;
            background: #1a1a1a;
            color: white;
            transition: left 0.3s ease;
            z-index: 999;
            padding-top: 80px;
            box-shadow: 2px 0 5px rgba(0,0,0,0.5);
        }

        .side-menu ul {
            list-style: none;
            padding: 0;
        }

        .side-menu ul li a {
            display: block;
            padding: 15px 25px;
            color: white;
            text-decoration: none;
            border-bottom: 1px solid #333;
            font-family: sans-serif;
        }

        .side-menu ul li a:hover {
            background: #333;
            color: #ffd700; /* Cor de destaque (ouro) */
        }

        /* LÓGICA DE ABERTURA */
        #menu-toggle:checked ~ .side-menu {
            left: 0;
        }

        /* Overlay */
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            display: none;
            z-index: 998;
        }

        #menu-toggle:checked ~ .overlay {
            display: block;
        }

        /* Ajuste para o conteúdo não ficar por baixo do botão no PC */
        .hero {
            padding-top: 60px;
        }

        /* Responsividade Celular */
        @media (max-width: 767px) {
            .side-menu {
                width: 80%;
                left: -80%;
            }
            #menu-toggle:checked ~ .side-menu {
                left: 0;
            }
        }
    

















/* ============================================================
   HERO
============================================================ */
.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('../images/1440.avif') center/cover no-repeat;
    padding: 100px 1.5rem 4rem;
    text-align: center;
}
.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.85) 100%);
}
.hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    animation: fadeInUp 1s ease;
}
.hero-tag {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #D6B377;
    margin-bottom: 1.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid #D6B377;
    border-radius: 20px;
}
.hero-title {
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #fff;
}
.hero-subtitle {
    font-size: 1rem;
    font-weight: 300;
    color: #ccc;
    margin-bottom: 2rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
}
.hero-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
}
.hero-buttons .btn { width: 100%; max-width: 750px; }
.hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: bounce 2s infinite;
}
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(80px); }
    to   { opacity: 1; transform: translateY(0); }
}
.hero-tag      { animation: fadeInUp 0.8s ease 0.1s both; }
.hero-title    { animation: fadeInUp 0.8s ease 0.3s both; }
.hero-subtitle { animation: fadeInUp 0.8s ease 0.5s both; }
.hero-buttons  { animation: fadeInUp 0.8s ease 0.7s both; }

